# Select one language model provider: ollama, mistral, or groq
LLM_PROVIDER=ollama

# Ollama Cloud (requires an Ollama API key; usage is limited by your plan)
OLLAMA_MODE=cloud
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_MODEL=gemma4:31b

# For local Ollama instead, set OLLAMA_MODE=local and use a downloaded model.
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_BASE_URL=http://localhost:11434

# For Mistral, set LLM_PROVIDER=mistral and provide this key.
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest

# For Groq, set LLM_PROVIDER=groq and provide this key.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# Needed only for Hinglish transcription through Sarvam.
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v2.5

# Local Whisper model: tiny, base, small, medium, or large.
WHISPER_MODEL=base
